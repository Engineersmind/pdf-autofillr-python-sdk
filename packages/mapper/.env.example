# pdf-autofillr-mapper — environment variables (secrets only)
# Copy to .env. Non-secret settings go in configs/mapper_config.ini.

# ── LLM Credentials ───────────────────────────────────────────
# The mapper uses two LLM phases internally (mapping + headers).
# Each phase reads its model from mapper_config.ini and its key from here.
#
# Option A — universal overrides (simplest, works for any provider):
MAPPER_LLM_API_KEY=           # mapping phase  (Phase 1)
MAPPER_HEADERS_LLM_API_KEY=   # headers phase  (Phase 2) — blank = reuse above
#
# Option B — provider-specific (litellm auto-routes by model name prefix):
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GROQ_API_KEY=gsk_...
# GEMINI_API_KEY=
# AZURE_API_KEY=
# AZURE_API_BASE=https://your-resource.openai.azure.com/
# AZURE_API_VERSION=2024-02-01

# ── AWS (only when source_type=aws in mapper_config.ini) ─────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION_NAME=us-east-1

# ── Server auth ───────────────────────────────────────────────
MAPPER_API_KEY=

# ── RAG Integration ───────────────────────────────────────────
# These activate when [rag] enabled=true in mapper_config.ini
# RAG_ENABLED=false              # set true to enable RAG after mapping
# RAG_MODE=inprocess             # inprocess | http
# RAG_API_URL=                   # only needed when RAG_MODE=http
# RAG_API_KEY=                   # only needed when RAG_MODE=http

# RAG SDK paths (read by ragpdf when RAG_MODE=inprocess)
# RAGPDF_STORAGE=local
# RAGPDF_DATA_PATH=./data/rag
# RAGPDF_EMBEDDING_BACKEND=sentence_transformer
# RAGPDF_ST_MODEL=all-MiniLM-L6-v2
# RAGPDF_VECTOR_STORE=local
# RAGPDF_CORRECTOR_BACKEND=noop
# RAGPDF_PREDICTION_THRESHOLD=0.75