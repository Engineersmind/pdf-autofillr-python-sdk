# pdf-autofillr-mapper — environment variables
# Secrets only. Copy to .env and fill in. DO NOT commit .env.
#
# LLM model is set in mapper_config.ini (non-secret).
# API keys go here (secret).

# ── Option A: Universal overrides (one key per phase) ────────────────────────
# Use these when both phases use the same provider,
# or when you want a single env var regardless of which provider.
MAPPER_LLM_API_KEY=           # mapping phase  (Phase 1)
MAPPER_HEADERS_LLM_API_KEY=   # headers phase  (Phase 2) — leave blank to reuse MAPPER_LLM_API_KEY

# ── Option B: Provider-specific keys (litellm auto-routes by model name) ─────
# Set only the key(s) matching your llm_model / headers_llm_model in mapper_config.ini.

# OpenAI  (llm_model = gpt-4o  or  openai/gpt-4o)
OPENAI_API_KEY=sk-...

# Anthropic  (llm_model = claude-3-5-sonnet-20241022  or  anthropic/claude-...)
ANTHROPIC_API_KEY=sk-ant-...

# Groq  (llm_model = groq/llama-3.1-70b-versatile)
GROQ_API_KEY=gsk_...

# Gemini  (llm_model = gemini/gemini-1.5-pro)
GEMINI_API_KEY=

# Azure OpenAI  (llm_model = azure/gpt-4o)
AZURE_API_KEY=
AZURE_API_BASE=https://your-resource.openai.azure.com/
AZURE_API_VERSION=2024-02-01

# AWS Bedrock  (llm_model = bedrock/anthropic.claude-3-5-sonnet-20241022-v2:0)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=us-east-1

# Ollama (local)  (llm_model = ollama/llama3.2) — no key needed
# ─────────────────────────────────────────────────────────────────────────────

# Mapper server auth (when running pdf-mapper-server with authentication)
MAPPER_API_KEY=

# RAG second mapper (when rag_enabled = true and rag_mode = http)
RAG_API_URL=
RAG_API_KEY=