# pdf-autofillr-mapper — environment variables
# Secrets only. Copy to .env and fill in. DO NOT commit .env.

# LLM (set the one matching your llm_model in mapper_config.ini)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
AZURE_API_KEY=
AZURE_API_BASE=https://your-resource.openai.azure.com/
AZURE_API_VERSION=2023-05-15

# AWS (required when source_type = aws)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=us-east-1

# Mapper server auth (when running api_server.py with authentication)
MAPPER_API_KEY=

# RAG second mapper (when use_second_mapper = true)
RAG_API_KEY=
