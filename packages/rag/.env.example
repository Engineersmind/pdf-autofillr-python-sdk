# ============================================================
# pdf-autofillr-rag — complete environment reference
# Copy this to .env and fill in the values for your setup.
# Only fill the sections relevant to your chosen backends.
# ============================================================


# ════════════════════════════════════════════════════════════
# 1. STORAGE  (where predictions, metrics, feedback are saved)
#    RAGPDF_STORAGE = local | s3 | azure | gcs
# ════════════════════════════════════════════════════════════

RAGPDF_STORAGE=local
RAGPDF_DATA_PATH=./data/rag

# ── S3 (when RAGPDF_STORAGE=s3) ──────────────────────────────
# AWS credentials via env vars, ~/.aws/credentials, or IAM role
# RAGPDF_S3_BUCKET=your-ragpdf-bucket
# RAGPDF_S3_REGION=us-east-1
# RAGPDF_S3_PREFIX=ragpdf/
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# ── Azure Blob (when RAGPDF_STORAGE=azure) ───────────────────
# Option A — connection string (easiest):
# RAGPDF_AZURE_CONN_STR=DefaultEndpointsProtocol=https;AccountName=...
# Option B — managed identity / CLI login:
# RAGPDF_AZURE_ACCOUNT=mystorageaccount
# RAGPDF_AZURE_CONTAINER=ragpdf

# ── GCS (when RAGPDF_STORAGE=gcs) ───────────────────────────
# Set GOOGLE_APPLICATION_CREDENTIALS or use gcloud auth login
# RAGPDF_GCS_BUCKET=your-ragpdf-bucket
# RAGPDF_GCS_PREFIX=ragpdf/


# ════════════════════════════════════════════════════════════
# 2. EMBEDDING BACKEND  (converts field context → vector)
#    RAGPDF_EMBEDDING_BACKEND = sentence_transformer | openai | litellm | noop
#
#    sentence_transformer  → local model, no API key needed (default, matches rag-lambda)
#    openai                → text-embedding-3-small / text-embedding-ada-002
#    litellm               → ANY provider via one model string
#    noop                  → zero vectors — unit tests ONLY, never production
# ════════════════════════════════════════════════════════════

RAGPDF_EMBEDDING_BACKEND=sentence_transformer
RAGPDF_ST_MODEL=all-MiniLM-L6-v2

# ── OpenAI embeddings (when RAGPDF_EMBEDDING_BACKEND=openai) ─
# OPENAI_API_KEY=sk-...
# RAGPDF_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── LiteLLM embeddings (when RAGPDF_EMBEDDING_BACKEND=litellm)
# Set RAGPDF_LITELLM_EMBEDDING_MODEL to provider/model-name:
#
#   OpenAI:         openai/text-embedding-3-small
#   Azure OpenAI:   azure/my-embedding-deployment       + AZURE_API_KEY, AZURE_API_BASE, AZURE_API_VERSION
#   Cohere:         cohere/embed-english-v3.0            + COHERE_API_KEY
#   AWS Bedrock:    bedrock/amazon.titan-embed-text-v1   + AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION_NAME
#   Google Vertex:  vertex_ai/textembedding-gecko        + GOOGLE_APPLICATION_CREDENTIALS, VERTEX_PROJECT, VERTEX_LOCATION
#   Ollama (local): ollama/nomic-embed-text              (no key — Ollama must be running on localhost:11434)
#
# RAGPDF_LITELLM_EMBEDDING_MODEL=openai/text-embedding-3-small
# OPENAI_API_KEY=sk-...


# ════════════════════════════════════════════════════════════
# 3. VECTOR STORE  (where the learned vector database lives)
#    RAGPDF_VECTOR_STORE = local | s3 | azure | gcs | pinecone | chroma | weaviate
#
#    local    → flat JSON on disk — zero deps, great for dev
#    s3       → flat JSON in S3 — same logic, cloud-persisted
#    azure    → flat JSON in Azure Blob
#    gcs      → flat JSON in GCS
#    pinecone → managed vector DB with native similarity search
#    chroma   → local embedded DB (no server needed)
#    weaviate → self-hosted or cloud Weaviate
#
#    NOTE: For local/s3/azure/gcs, the vector DB is ONE JSON file:
#      vectors/vector_database.json
#    This file path is relative to RAGPDF_DATA_PATH (local) or
#    RAGPDF_S3_PREFIX / RAGPDF_AZURE_CONTAINER / RAGPDF_GCS_PREFIX (cloud).
# ════════════════════════════════════════════════════════════

RAGPDF_VECTOR_STORE=local

# ── Pinecone (when RAGPDF_VECTOR_STORE=pinecone) ─────────────
# PINECONE_API_KEY=your-pinecone-api-key
# RAGPDF_PINECONE_INDEX=ragpdf-vectors
# RAGPDF_PINECONE_NAMESPACE=default

# ── ChromaDB (when RAGPDF_VECTOR_STORE=chroma) ───────────────
# RAGPDF_CHROMA_PATH=./chroma_data
# RAGPDF_CHROMA_COLLECTION=ragpdf_vectors

# ── Weaviate (when RAGPDF_VECTOR_STORE=weaviate) ─────────────
# RAGPDF_WEAVIATE_URL=http://localhost:8080
# RAGPDF_WEAVIATE_API_KEY=
# RAGPDF_WEAVIATE_CLASS=RagpdfVector


# ════════════════════════════════════════════════════════════
# 4. LLM CORRECTOR  (used during feedback/API 4 only)
#    Called when a user reports a wrong prediction.
#    Generates the corrected snake_case field name.
#    RAGPDF_CORRECTOR_BACKEND = noop | openai | anthropic | litellm
#
#    noop      → no LLM, just cleans field name to snake_case (safe default)
#    openai    → GPT-4 (matches rag-lambda default)
#    anthropic → Claude
#    litellm   → any provider
# ════════════════════════════════════════════════════════════

RAGPDF_CORRECTOR_BACKEND=noop

# ── OpenAI corrector (when RAGPDF_CORRECTOR_BACKEND=openai) ──
# OPENAI_API_KEY=sk-...
# RAGPDF_OPENAI_MODEL=gpt-4-turbo-preview
# RAGPDF_OPENAI_TEMPERATURE=0.3
# RAGPDF_OPENAI_MAX_TOKENS=500

# ── Anthropic corrector (when RAGPDF_CORRECTOR_BACKEND=anthropic)
# ANTHROPIC_API_KEY=sk-ant-...
# RAGPDF_ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── LiteLLM corrector (when RAGPDF_CORRECTOR_BACKEND=litellm)
# Set RAGPDF_LITELLM_CORRECTOR_MODEL to provider/model-name:
#
#   OpenAI:       openai/gpt-4o-mini
#   Anthropic:    anthropic/claude-3-haiku-20240307
#   Azure:        azure/my-gpt4-deployment
#   Groq (fast):  groq/llama-3.1-8b-instant           + GROQ_API_KEY
#   Bedrock:      bedrock/anthropic.claude-3-haiku-20240307-v1:0
#   Ollama local: ollama/llama3.1
#
# RAGPDF_LITELLM_CORRECTOR_MODEL=openai/gpt-4o-mini
# RAGPDF_LITELLM_CORRECTOR_TEMP=0.3
# RAGPDF_LITELLM_CORRECTOR_TOKENS=500


# ════════════════════════════════════════════════════════════
# 5. PREDICTION TUNING  (matches rag-lambda defaults exactly)
# ════════════════════════════════════════════════════════════

RAGPDF_PREDICTION_THRESHOLD=0.75
RAGPDF_TOP_K=5
RAGPDF_AMBIGUITY_THRESHOLD=0.10
RAGPDF_CONFIDENCE_DECAY_RATE=0.95
RAGPDF_CONFIDENCE_GROWTH_RATE=1.05
RAGPDF_MAX_CONFIDENCE=0.99
RAGPDF_MIN_CONFIDENCE=0.50


# ════════════════════════════════════════════════════════════
# 6. SERVER  (FastAPI / Lambda / Azure / GCP entrypoints)
# ════════════════════════════════════════════════════════════

RAGPDF_API_KEY=dev-key
RAGPDF_SERVER_HOST=0.0.0.0
RAGPDF_SERVER_PORT=8000


# ════════════════════════════════════════════════════════════
# 7. DEBUG
# ════════════════════════════════════════════════════════════

RAGPDF_DEBUG=false
RAGPDF_LOG_LEVEL=INFO
