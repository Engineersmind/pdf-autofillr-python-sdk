# ─────────────────────────────────────────────────────────────────────────────
# pdf-autofillr-doc-upload — Environment Variables
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM ──────────────────────────────────────────────────────────────────────
# LiteLLM model string — any provider:
#   openai/gpt-4.1-mini                              → set OPENAI_API_KEY
#   openai/gpt-4o                                    → set OPENAI_API_KEY
#   anthropic/claude-3-5-haiku-20241022              → set ANTHROPIC_API_KEY
#   anthropic/claude-3-5-sonnet-20241022             → set ANTHROPIC_API_KEY
#   bedrock/anthropic.claude-3-haiku-20240307-v1:0   → AWS creds, no key needed
#   azure/gpt-4o                                     → set AZURE_API_KEY + AZURE_API_BASE
#   vertex_ai/gemini-1.5-flash                       → set GOOGLE_APPLICATION_CREDENTIALS
#   groq/llama-3.1-8b-instant                        → set GROQ_API_KEY
#   ollama/llama3.1                                  → run Ollama locally, no key needed
DOC_UPLOAD_LLM_MODEL=openai/gpt-4.1-mini

# Universal API key — maps to the right provider automatically via LiteLLM
DOC_UPLOAD_LLM_API_KEY=sk-...

# Provider-specific keys (used directly by LiteLLM if DOC_UPLOAD_LLM_API_KEY not set)
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GROQ_API_KEY=gsk_...
# AZURE_API_KEY=
# AZURE_API_BASE=https://your-resource.openai.azure.com/
# AZURE_API_VERSION=2023-05-15

# LLM tuning (optional — defaults shown)
# DOC_UPLOAD_LLM_TEMPERATURE=0
# DOC_UPLOAD_LLM_MAX_TOKENS=4096
# DOC_UPLOAD_LLM_TIMEOUT=120
# DOC_UPLOAD_LLM_MAX_RETRIES=3

# ── Storage ───────────────────────────────────────────────────────────────────
# local | s3 | gcp | azure
DOC_UPLOAD_STORAGE=local
DOC_UPLOAD_DATA_PATH=./data/doc_upload
DOC_UPLOAD_CONFIG_PATH=./configs

# S3 (only needed when DOC_UPLOAD_STORAGE=s3)
# AWS_OUTPUT_BUCKET=my-doc-upload-output
# AWS_CONFIG_BUCKET=my-doc-upload-config
# AWS_REGION=us-east-1

# GCP (only needed when DOC_UPLOAD_STORAGE=gcp)
# GCP_OUTPUT_BUCKET=my-doc-upload-output
# GCP_CONFIG_BUCKET=my-doc-upload-config
# GCP_PROJECT_ID=my-project

# Azure (only needed when DOC_UPLOAD_STORAGE=azure)
# AZURE_OUTPUT_CONTAINER=doc-upload-output
# AZURE_CONFIG_CONTAINER=doc-upload-config
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net

# ── PDF Filling ───────────────────────────────────────────────────────────────
# none | mapper | managed
#
# none    — extract only, no PDF filling (default)
# mapper  — fill a PDF via the mapper module
#             MAPPER_API_URL empty → in-process (local dev, same Python process)
#             MAPPER_API_URL set   → HTTP (production, mapper running as a server)
# managed — (stub) reserved for future managed cloud service
#
DOC_UPLOAD_PDF_FILLER=none

# Path to the blank PDF to fill
# Windows: DOC_UPLOAD_PDF_PATH=C:/Users/you/Desktop/blank_form.pdf
# Linux:   DOC_UPLOAD_PDF_PATH=/home/you/forms/blank_form.pdf
# S3:      DOC_UPLOAD_PDF_PATH=s3://my-bucket/forms/blank_form.pdf
DOC_UPLOAD_PDF_PATH=

# Mapper connection — leave empty for in-process mode
MAPPER_API_URL=
MAPPER_API_KEY=

# PDF filling tuning (optional — defaults shown)
# DOC_UPLOAD_PDF_POLL_INTERVAL=10
# DOC_UPLOAD_PDF_POLL_TIMEOUT=150
# DOC_UPLOAD_PDF_MAX_RETRIES=3

# ── Telemetry ─────────────────────────────────────────────────────────────────
# off | local | managed | self-hosted
#
# off   — completely disabled, zero overhead (default)
# local — append events to DOC_UPLOAD_TELEMETRY_PATH/events.jsonl
#         Field values are NEVER logged. Only metadata (counts, latency, file ext).
#
DOC_UPLOAD_TELEMETRY=off
# DOC_UPLOAD_TELEMETRY_PATH=./doc_upload_telemetry

# ── Server (FastAPI / uvicorn) ────────────────────────────────────────────────
# DOC_UPLOAD_HOST=0.0.0.0
# DOC_UPLOAD_PORT=8001
# DOC_UPLOAD_RELOAD=false

# ── Auth (FastAPI server / Lambda) ────────────────────────────────────────────
# When set, all API endpoints require X-API-Key: <AUTH_TOKEN> header
# AUTH_TOKEN=my-secret-token

# ── Logging ───────────────────────────────────────────────────────────────────
DOC_UPLOAD_LOG_LEVEL=INFO
DOC_UPLOAD_DEBUG_LOGGING=false
